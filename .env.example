POSTGRES_DB=catalog_db
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-production
CATALOG_DATABASE_URL=postgresql+asyncpg://app:change-me-in-production@postgres:5432/catalog_db
AUTH_DATABASE_URL=postgresql+asyncpg://app:change-me-in-production@postgres:5432/auth_db
ORDERS_DATABASE_URL=postgresql+asyncpg://app:change-me-in-production@postgres:5432/orders_db
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://app:change-me-in-production@rabbitmq:5672/
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
STOREFRONT_AUTH_API_URL=http://localhost:8102/api/v1/auth
STOREFRONT_CATALOG_API_URL=http://localhost:8101/api/v1/catalog
STOREFRONT_ORDERS_API_URL=http://localhost:8103/api/v1/orders
# Local bootstrap account. Set a controlled email, then use an empty value to disable bootstrap.
ADMIN_EMAIL=admin@example.com
ADMIN_AUTH_API_URL=http://localhost:8102/api/v1/auth
ADMIN_CATALOG_API_URL=http://localhost:8101/api/v1/admin/catalog
ADMIN_ORDERS_API_URL=http://localhost:8103/api/v1/admin/orders
ADMIN_MEDIA_API_URL=http://localhost:8104/api/v1/media

# MinIO: replace every secret before any public deployment.
MINIO_ROOT_USER=sabr-root
MINIO_ROOT_PASSWORD=replace-with-at-least-32-random-characters
MINIO_MEDIA_ACCESS_KEY=sabr-media-service
MINIO_MEDIA_SECRET_KEY=replace-with-another-strong-random-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/sabr-product-media

# Do not keep real keys in git. Use EMAIL_PROVIDER=mock for local development.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=SABR <login@example.com>
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-another-random-secret
